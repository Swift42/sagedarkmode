{
  "manifest_version": 3,
  "name": "Sage Dark Mode",
  "key": "BTUQKtw8N05gH9GJ90xWP7OA65sH",
  "version": "1.0.1",
  "description": "Dark mode for Sage",
  "permissions": [
	"declarativeNetRequest",
	"declarativeNetRequestFeedback",
	"storage"
  ],
  "externally_connectable": {
    "matches": ["https://based.staratlas.com/*"]
  },  
  "host_permissions": [
    "https://based.staratlas.com/*"
  ],
  "background": {
    "service_worker": "background-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["my-map-hires.jpg", "my-map-hires2.jpg", "my-map-hires3.jpg"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": false
    }
  ],
  "content_scripts": [
  {
     "matches": ["https://based.staratlas.com/*"],
     "js": ["isolated.js"],
     "run_at": "document_start"
   },	
   {
     "matches": ["https://based.staratlas.com/*"],
     "js": ["content.js"],
	 "world": "MAIN",
	 "run_at": "document_end"
   }
 ],
 "action": {
    "default_popup": "popup.html",
	"default_icon": {
	  "16": "icon-16.png",
	  "48": "icon-48.png",
	  "128": "icon-128.png"
	}	
  },
  "icons": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
  }  
}
